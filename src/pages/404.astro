---
import BaseLayout from "@/layouts/BaseLayout.astro"
---

<BaseLayout title="Página no encontrada — Tenka" description="La página que buscas no existe." noindex={true}>
  <section class="min-h-screen flex items-center justify-center">
    <div class="text-center">
      <h1 class="font-display text-6xl text-cyan">404</h1>
      <p class="mt-4 text-text-secondary text-lg">Página no encontrada</p>
      <a href="/" class="mt-8 inline-flex items-center gap-2 px-6 py-3 bg-cyan text-black text-sm font-semibold rounded-xl hover:brightness-110 transition-all">
        Volver al inicio
      </a>
    </div>
  </section>
</BaseLayout>
