---
interface Props {
  kind: "liga" | "equipo"
}

const { kind } = Astro.props
const isLeague = kind === "liga"
const title = isLeague ? "Liga compartida — Tenka" : "Equipo compartido — Tenka"
const heading = isLeague ? "Enlace de liga" : "Enlace de equipo"
const description = isLeague
  ? "Te invitaron a ver una liga en Tenka. Abre este enlace desde la aplicación."
  : "Te compartieron un equipo en Tenka. Abre este enlace desde la aplicación."
const canonicalUrl = `https://tenka.studio/${kind}`
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/assets/icon.png" />
    <link rel="apple-touch-icon" href="/assets/icon.png" />
    <meta name="robots" content="noindex,follow" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://tenka.studio/assets/icon.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1254" />
    <meta property="og:image:height" content="1254" />
    <meta property="og:image:alt" content="Tenka" />
    <meta property="og:locale" content="es_MX" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://tenka.studio/assets/icon.png" />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: 'Inter', sans-serif;
        background: #090B10;
        color: #FFFFFF;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }
      .card {
        background: #171C26;
        border: 1px solid #293241;
        border-radius: 16px;
        padding: 32px 24px;
        max-width: 360px;
        width: 100%;
        text-align: center;
      }
      h1 { font-family: 'Sora', sans-serif; font-size: 18px; font-weight: 600; margin-bottom: 8px; }
      p { color: #7A8598; font-size: 13px; line-height: 1.5; margin-bottom: 24px; }
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #4DD0E1;
        color: #090B10;
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 15px;
        padding: 12px 24px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        text-decoration: none;
      }
      .btn:hover { background: #7CE7F2; }
      .site-link { display: block; margin-top: 18px; color: #4DD0E1; font-size: 12px; text-decoration: none; }
      .site-link:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <div class="card">
      <img src="/assets/icon.png" alt="Tenka" style="width: 64px; height: 64px; margin-bottom: 16px;" />
      <h1>{heading}</h1>
      <p>
        Este enlace solo funciona para personas que ya participan en las pruebas de Tenka. La aplicación aún no está disponible públicamente.
      </p>
      <a class="btn" id="openBtn">Abrir en Tenka</a>
      <a class="site-link" href="/#lista-espera">Únete a la lista de espera</a>
      <script is:inline define:vars={{ kind }}>
        const path = window.location.pathname.replace(new RegExp(`^/${kind}/?`), '')
        const button = document.getElementById('openBtn')
        if (button instanceof HTMLAnchorElement) {
          button.href = path ? `tenka://${kind}/${path}` : `tenka://${kind}`
        }
      </script>
    </div>
  </body>
</html>
