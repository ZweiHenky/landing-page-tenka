---
export interface Props {
  title: string
  subtitle?: string
  align?: "left" | "center"
  class?: string
}

const { title, subtitle, align = "center", class: className } = Astro.props
---

<div class={`flex flex-col ${align === "center" ? "items-center text-center" : "items-start text-left"} ${className ?? ""}`}>
  <h2 class="font-display text-3xl md:text-4xl lg:text-5xl text-white text-balance">
    {title}
  </h2>
  {subtitle && (
    <p class="mt-4 max-w-2xl text-text-secondary text-base md:text-lg leading-relaxed">
      {subtitle}
    </p>
  )}
  <div class="mt-4 w-12 h-[2px] bg-cyan/50" />
</div>
