---
import TacticalBackground from "@/components/TacticalBackground.astro"

const formats = [
  {
    label: "Suma a la tabla",
    title: "Partido de liga",
    text: "Forma parte del calendario oficial. El resultado suma estadísticas y puntos para ambos equipos en la tabla de posiciones.",
    color: "text-cyan",
  },
  {
    label: "No suma puntos",
    title: "Partido amistoso",
    text: "Un encuentro de preparación o exhibición que no modifica los puntos ni las posiciones de la liga.",
    color: "text-warning",
  },
  {
    label: "Un equipo suma",
    title: "Partido de complemento",
    text: "Ayuda a que un equipo con menos partidos alcance al resto. Solo el equipo designado suma el resultado en la tabla.",
    color: "text-success",
  },
  {
    label: "Avanza de ronda",
    title: "Partido eliminatorio",
    text: "Forma parte de una llave de playoffs. El ganador avanza a la siguiente ronda hasta llegar a la final.",
    color: "text-playoff",
  },
]
---

<section id="tipos-partido" class="relative overflow-hidden bg-[#101218] py-24 md:py-32">
  <TacticalBackground variant="grid" align="left" />
  <div class="relative mx-auto grid max-w-[1280px] gap-14 px-6 md:px-8 lg:grid-cols-[0.76fr_1.24fr] lg:items-center lg:px-12">
    <div>
      <p class="section-kicker">04 / Formatos</p>
      <h2 class="mt-5 font-display text-3xl leading-tight text-white md:text-5xl">Adapta el torneo a tu formato de competencia.</h2>
      <p class="mt-5 leading-relaxed text-text-secondary">Organiza una liga regular, partidos adicionales o una fase eliminatoria con llaves hasta la final.</p>
      <a href="#lista-espera" class="mt-8 inline-flex items-center gap-3 border-b border-cyan pb-2 text-sm font-semibold text-cyan">Quiero enterarme del lanzamiento <span>→</span></a>
    </div>

    <div class="grid gap-px border border-white/10 bg-white/10 sm:grid-cols-2">
      {formats.map((format, index) => (
        <article class="group relative flex min-h-64 flex-col overflow-hidden bg-[#151922] p-6 md:p-7">
          <span class:list={["text-[10px] font-semibold uppercase tracking-[0.16em]", format.color]}>{format.label}</span>
          <span class="absolute right-5 top-4 font-brand text-6xl text-white/[.025]">0{index + 1}</span>
          <div class="relative mt-auto flex items-end justify-between gap-5 pt-12">
            <div class="min-w-0"><h3 class="font-display text-xl leading-snug text-white">{format.title}</h3><p class="mt-3 text-sm leading-relaxed text-text-muted">{format.text}</p></div>
            <span class:list={["h-8 w-8 shrink-0 border border-current opacity-50", format.color]}></span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
