---
import TacticalBackground from "@/components/TacticalBackground.astro"

const formats = [
  { code: "LIG", title: "Regular", text: "Jornadas y tabla acumulada", color: "text-cyan" },
  { code: "AMST", title: "Amistoso", text: "Partido fuera de clasificación", color: "text-warning" },
  { code: "+", title: "Complemento", text: "Encuentro adicional controlado", color: "text-success" },
  { code: "KO", title: "Eliminatoria", text: "Llaves hasta la final", color: "text-playoff" },
]
---

<section id="tipos-partido" class="relative overflow-hidden bg-[#101218] py-24 md:py-32">
  <TacticalBackground variant="grid" align="left" />
  <div class="relative mx-auto grid max-w-[1280px] gap-14 px-6 md:px-8 lg:grid-cols-[0.76fr_1.24fr] lg:items-center lg:px-12">
    <div>
      <p class="section-kicker">04 / Formatos</p>
      <h2 class="mt-5 font-display text-3xl leading-tight text-white md:text-5xl">La estructura que tu competencia necesita.</h2>
      <p class="mt-5 leading-relaxed text-text-secondary">Desde una temporada regular hasta la final, cada partido conserva su propósito y su lugar en la historia.</p>
      <a href="#lista-espera" class="mt-8 inline-flex items-center gap-3 border-b border-cyan pb-2 text-sm font-semibold text-cyan">Quiero enterarme del lanzamiento <span>→</span></a>
    </div>

    <div class="grid gap-px border border-white/10 bg-white/10 sm:grid-cols-2">
      {formats.map((format, index) => (
        <article class="group relative min-h-48 overflow-hidden bg-[#151922] p-6 md:p-7">
          <span class:list={["font-brand text-xs tracking-[0.18em]", format.color]}>{format.code}</span>
          <span class="absolute right-5 top-4 font-brand text-6xl text-white/[.025]">0{index + 1}</span>
          <div class="mt-14 flex items-end justify-between gap-4">
            <div><h3 class="font-display text-xl text-white">{format.title}</h3><p class="mt-2 text-sm text-text-muted">{format.text}</p></div>
            <span class:list={["h-8 w-8 border border-current opacity-50", format.color]}></span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
